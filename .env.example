# =======================================================
# Voice AI Personal Assistant - Environment Configuration
# =======================================================

# FastAPI Server Port
PORT=8000

# PostgreSQL Database Connection URL (Optional)
# If provided, backend connects directly to PostgreSQL.
# If omitted, backend automatically falls back to local SQLite (data/assistant.db).
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_ai_assistant

# Groq Cloud API Credentials (LPUs for Instant Llama 3.3 & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Dedicated Voice AI Frameworks & Provider API Keys (No Browser Speech APIs)
# 1. Deepgram STT API (Nova-2 STT for ultra-fast speech recognition)
DEEPGRAM_API_KEY=

# 2. Sarvam AI API (Saarathi STT & Bulbul TTS for Indian languages: Hindi & Kannada)
SARVAM_API_KEY=

# 3. ElevenLabs TTS API (Multilingual v2 for ultra-realistic voice synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Calendar API Integration Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
